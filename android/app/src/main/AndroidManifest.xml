<?xml version="1.0" encoding="utf-8"?>
<manifest package="com.lokoimmeuble.app" xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="Loko Immeuble"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LokoImmeuble">

        <activity android:name="com.lokoimmeuble.app.SplashActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="com.lokoimmeuble.app.MainActivity" />

    </application>

</manifest>
