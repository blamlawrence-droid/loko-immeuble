%%Creator: (ImageMagick)
%%Title: (dist/branding/svg/logo-master.eps)
%%CreationDate: (2026-09-02T00:40:12+00:00)
%%BoundingBox: -0 -0 450 150
%%HiResBoundingBox: 0 0 450 150
